{
  "name": "@dronelink/hosted",
  "version": "1.0.0",
  "description": "Independently installed DroneLink hosted backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "npm run test:application",
    "test:application": "node --test tests/application/lifecycle.test.cjs tests/native/*.test.cjs",
    "test:integration": "node --test tests/native/*.test.cjs",
    "test:firestore:prepare": "node tools/firestore.cjs --prepare",
    "release:prepare": "python3 tools/operations/release.py prepare",
    "release:verify": "python3 tools/operations/release.py verify",
    "deploy:staging": "python3 tools/operations/staging.py deploy",
    "rollback:staging": "python3 tools/operations/staging.py rollback",
    "legacy:archive": "python3 tools/operations/legacy.py archive",
    "legacy:verify": "python3 tools/operations/legacy.py verify",
    "legacy:cleanse": "python3 tools/operations/legacy.py cleanse",
    "test:operations": "python3 -m unittest discover -s tests/operations -p \"test_*.py\" && node --test tests/operations/*.test.cjs",
    "test:staging": "node tools/staging-check.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "crypto": "^1.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "@dronelink/persistence": "file:vendor/dronelink-persistence-0.5.0.tgz",
    "@dronelink/protocol": "file:vendor/dronelink-protocol-0.2.0.tgz"
  },
  "private": true,
  "type": "commonjs",
  "devDependencies": {},
  "overrides": {
    "debug": "4.4.1"
  }
}
